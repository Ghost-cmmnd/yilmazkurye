---
import Logo from "./Logo.astro";
import { Icon } from "astro-icon/components";
import { NAV_LINKS, CONTACT } from "../data/site";
---

<header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/90 backdrop-blur-md">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
    <Logo />

    <nav class="hidden items-center gap-6 lg:flex">
      {NAV_LINKS.map((link) => (
        <a
          href={link.href}
          class="text-sm font-medium text-slate-600 transition hover:text-orange-600"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <a href={`tel:${CONTACT.phoneTel}`} class="flex items-center gap-2 text-sm font-semibold text-slate-700">
        <Icon name="lucide:phone" class="h-4 w-4 text-orange-600" />
        {CONTACT.phoneDisplay}
      </a>
      <a href="/#iletisim" class="btn-primary !px-5 !py-2.5 text-sm">
        Teklif Al
      </a>
    </div>

    <button
      id="mobile-menu-button"
      type="button"
      class="inline-flex items-center justify-center rounded-lg p-2 text-slate-700 lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Menüyü aç"
    >
      <Icon name="lucide:menu" class="h-6 w-6" />
    </button>
  </div>

  <nav id="mobile-menu" class="hidden flex-col gap-1 border-t border-slate-200 bg-white px-4 py-4 lg:hidden">
    {NAV_LINKS.map((link) => (
      <a
        href={link.href}
        class="rounded-lg px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50"
      >
        {link.label}
      </a>
    ))}
    <a href={`tel:${CONTACT.phoneTel}`} class="mt-2 flex items-center gap-2 rounded-lg px-3 py-2 text-sm font-semibold text-slate-700">
      <Icon name="lucide:phone" class="h-4 w-4 text-orange-600" />
      {CONTACT.phoneDisplay}
    </a>
    <a href="/#iletisim" class="btn-primary mt-2 justify-center text-sm">
      Teklif Al
    </a>
  </nav>
</header>

<script>
  const button = document.getElementById("mobile-menu-button");
  const menu = document.getElementById("mobile-menu");

  button?.addEventListener("click", () => {
    const isOpen = menu?.classList.contains("hidden");
    menu?.classList.toggle("hidden", !isOpen);
    menu?.classList.toggle("flex", isOpen);
    button.setAttribute("aria-expanded", String(isOpen));
  });

  menu?.querySelectorAll("a").forEach((a) => {
    a.addEventListener("click", () => {
      menu.classList.add("hidden");
      menu.classList.remove("flex");
      button?.setAttribute("aria-expanded", "false");
    });
  });
</script>
