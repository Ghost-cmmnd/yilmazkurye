---
import { Icon } from "astro-icon/components";
---

<div
  id="live-toast"
  class="fixed bottom-24 left-4 z-40 w-[calc(100vw-2rem)] max-w-[340px] -translate-x-8 opacity-0 pointer-events-none transition-all duration-500 ease-out motion-reduce:transition-none motion-reduce:translate-x-0"
  aria-live="polite"
  role="status"
>
  <div class="flex items-start gap-3 rounded-2xl border border-slate-700/50 bg-slate-900/95 p-4 shadow-2xl shadow-black/30 backdrop-blur-xl">
    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-gradient-to-br from-amber-500 to-orange-500 text-white">
      <Icon name="lucide:package" class="h-4 w-4" data-icon="pickup" />
      <Icon name="lucide:circle-check" class="hidden h-4 w-4" data-icon="delivered" />
      <Icon name="lucide:truck" class="hidden h-4 w-4" data-icon="enroute" />
    </span>
    <div class="min-w-0 flex-1">
      <p id="live-toast-message" class="text-sm font-medium text-white"></p>
      <p id="live-toast-time" class="mt-1 text-xs text-slate-400"></p>
    </div>
  </div>
</div>

<script>
  import {
    FIRST_NAMES,
    LAST_INITIALS,
    DISTRICTS,
    PACKAGE_TYPES,
    TIME_AGO,
    EVENT_TYPES,
    TOAST_INITIAL_DELAY_MS,
    TOAST_INTERVAL_MS,
    TOAST_VISIBLE_MS,
  } from "../data/liveActivity";

  const pick = <T,>(arr: readonly T[]): T => arr[Math.floor(Math.random() * arr.length)];

  const randomPerson = () => `${pick(FIRST_NAMES)} ${pick(LAST_INITIALS)}.`;

  const randomDistrictPair = () => {
    const from = pick(DISTRICTS);
    let to = pick(DISTRICTS);
    while (to === from) to = pick(DISTRICTS);
    return { from, to };
  };

  const buildEvent = () => {
    const type = pick(EVENT_TYPES);
    const pkg = pick(PACKAGE_TYPES);
    const { from, to } = randomDistrictPair();
    const sender = randomPerson();
    const receiver = randomPerson();

    let message = "";
    if (type === "pickup") {
      message = `${sender} kişisinden ${pkg} teslim alındı → ${to}`;
    } else if (type === "delivered") {
      message = `${receiver} kişisine ${pkg} teslim edildi (${from} → ${to})`;
    } else {
      message = `${sender} → ${receiver} arası ${pkg} yolda`;
    }

    return { type, message, timeAgo: pick(TIME_AGO) };
  };

  const toast = document.getElementById("live-toast");
  const messageEl = document.getElementById("live-toast-message");
  const timeEl = document.getElementById("live-toast-time");
  const icons = toast?.querySelectorAll<HTMLElement>("[data-icon]");

  const HIDDEN_CLASSES = ["-translate-x-8", "opacity-0", "pointer-events-none"];
  const VISIBLE_CLASSES = ["translate-x-0", "opacity-100", "pointer-events-auto"];

  let hideTimer: ReturnType<typeof setTimeout> | undefined;

  const showToast = () => {
    if (!toast || !messageEl || !timeEl) return;
    const event = buildEvent();

    messageEl.textContent = event.message;
    timeEl.textContent = event.timeAgo;
    icons?.forEach((icon) => {
      icon.classList.toggle("hidden", icon.dataset.icon !== event.type);
    });

    toast.classList.remove(...HIDDEN_CLASSES);
    toast.classList.add(...VISIBLE_CLASSES);

    clearTimeout(hideTimer);
    hideTimer = setTimeout(() => {
      toast.classList.remove(...VISIBLE_CLASSES);
      toast.classList.add(...HIDDEN_CLASSES);
    }, TOAST_VISIBLE_MS);
  };

  setTimeout(showToast, TOAST_INITIAL_DELAY_MS);
  setInterval(showToast, TOAST_INTERVAL_MS);
</script>
