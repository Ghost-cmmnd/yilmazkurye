---
import { Icon } from "astro-icon/components";

interface Props {
  variant?: "dark" | "light";
}

const { variant = "dark" } = Astro.props;
const textClass = variant === "dark" ? "text-slate-900" : "text-white";
---

<a href="/" class="inline-flex items-center gap-2">
  <span class={`inline-block -skew-x-[8deg] font-black tracking-tight text-2xl ${textClass}`}>
    Yılmaz<span class="gradient-text">Kurye</span>
  </span>
  <svg class="h-7 w-6 shrink-0 text-orange-500" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="M2 6h9" stroke="currentColor" stroke-width="3" stroke-linecap="round" opacity="0.5" />
    <path d="M4 12.5h12" stroke="currentColor" stroke-width="3" stroke-linecap="round" opacity="0.75" />
    <path d="M6 19h10" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
  </svg>
  <Icon name="fa6-solid:motorcycle" class="-ml-1.5 h-7 w-9 shrink-0 -skew-x-[8deg] text-orange-500" />
</a>
