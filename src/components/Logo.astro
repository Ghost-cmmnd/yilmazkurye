---
import { Icon } from "astro-icon/components";

interface Props {
  variant?: "dark" | "light";
}

const { variant = "dark" } = Astro.props;
const textClass = variant === "dark" ? "text-slate-900" : "text-white";
---

<a href="/" class="inline-flex items-center gap-2 font-extrabold text-xl tracking-tight">
  <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-amber-500 to-orange-500 text-white shadow-md shadow-orange-500/30">
    <Icon name="lucide:zap" class="h-5 w-5" />
  </span>
  <span class={textClass}>Yılmaz<span class="gradient-text">Kurye</span></span>
</a>
