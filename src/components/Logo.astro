---
interface Props {
  variant?: "dark" | "light";
}

const { variant = "dark" } = Astro.props;
const textClass = variant === "dark" ? "text-slate-900" : "text-white";
---

<a href="/" class="inline-flex items-center">
  <span class={`inline-block -skew-x-[8deg] font-black tracking-tight text-2xl ${textClass}`}>
    Yılmaz<span class="gradient-text">Kurye</span>
  </span>
</a>
