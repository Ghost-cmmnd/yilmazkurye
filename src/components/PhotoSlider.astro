---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

import arabaliKurye from "../assets/slider/arabali-kurye.png";
import eczaneKurye from "../assets/slider/eczane-kurye.jpg";
import expresKurye from "../assets/slider/expres-kurye.jpg";
import geceKurye from "../assets/slider/gece-kurye.webp";
import motorKurye from "../assets/slider/motor-kurye.jpg";
import ucakKargoHizmeti from "../assets/slider/ucak-kargo-hizmeti.jpg";
import vipKurye from "../assets/slider/vip-kurye.jpg";

const slides = [
  { image: arabaliKurye, caption: "Arabalı Kurye" },
  { image: eczaneKurye, caption: "Eczane Kurye" },
  { image: expresKurye, caption: "Expres Kurye" },
  { image: geceKurye, caption: "Gece Kurye" },
  { image: motorKurye, caption: "Motor Kurye" },
  { image: ucakKargoHizmeti, caption: "Uçak Kargo Hizmeti" },
  { image: vipKurye, caption: "VIP Kurye" },
];
---

<section class="relative bg-slate-950 py-16 md:py-20">
  <div class="mx-auto mb-8 max-w-2xl px-4 text-center sm:px-6" data-reveal="up">
    <span class="section-eyebrow bg-amber-500/10 text-amber-400">Hizmetlerimizden Kareler</span>
    <h2 class="mt-4 text-3xl font-black tracking-tight text-white md:text-4xl">
      Yılmaz Kurye <span class="gradient-text">İş Başında</span>
    </h2>
  </div>

  <div
    id="photo-slider"
    class="group relative mx-auto w-[calc(100%-2rem)] max-w-3xl overflow-hidden rounded-2xl shadow-2xl shadow-black/40 sm:w-[calc(100%-3rem)] lg:w-[calc(100%-4rem)]"
    data-reveal="scale"
    role="region"
    aria-roledescription="carousel"
    aria-label="Yılmaz Kurye hizmet fotoğrafları"
  >
    <div id="slider-track" class="flex aspect-[4/3] transition-transform duration-700 ease-out">
      {slides.map((slide, i) => (
        <div class="relative h-full w-full shrink-0 overflow-hidden bg-slate-900" aria-hidden={i === 0 ? "false" : "true"}>
          <Image
            src={slide.image}
            alt={slide.caption}
            width={slide.image.width}
            height={slide.image.height}
            loading={i === 0 ? "eager" : "lazy"}
            class="h-full w-full object-cover object-center"
          />
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-slate-950/90 via-transparent to-transparent"></div>
          <div class="absolute inset-x-0 bottom-0 p-6 sm:p-8">
            <p class="text-xl font-bold text-white drop-shadow-lg sm:text-2xl">{slide.caption}</p>
          </div>
        </div>
      ))}
    </div>

    <button
      type="button"
      id="slider-prev"
      aria-label="Önceki fotoğraf"
      class="absolute left-3 top-1/2 z-10 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-slate-900/60 text-white opacity-0 backdrop-blur transition hover:bg-slate-900/80 focus-visible:opacity-100 group-hover:opacity-100 sm:h-12 sm:w-12"
    >
      <Icon name="lucide:arrow-left" class="h-5 w-5" />
    </button>
    <button
      type="button"
      id="slider-next"
      aria-label="Sonraki fotoğraf"
      class="absolute right-3 top-1/2 z-10 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-slate-900/60 text-white opacity-0 backdrop-blur transition hover:bg-slate-900/80 focus-visible:opacity-100 group-hover:opacity-100 sm:h-12 sm:w-12"
    >
      <Icon name="lucide:arrow-right" class="h-5 w-5" />
    </button>

    <div id="slider-dots" class="absolute inset-x-0 bottom-3 z-10 flex items-center justify-center gap-2">
      {slides.map((_, i) => (
        <button
          type="button"
          class="slider-dot h-2 w-2 rounded-full bg-white/40 transition-all"
          aria-label={`${i + 1}. fotoğrafa git`}
          data-index={i}
        />
      ))}
    </div>
  </div>
</section>

<script>
  const AUTO_ADVANCE_MS = 4500;

  const root = document.getElementById("photo-slider");
  const track = document.getElementById("slider-track") as HTMLElement | null;
  const prevBtn = document.getElementById("slider-prev");
  const nextBtn = document.getElementById("slider-next");
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>(".slider-dot"));

  if (root && track && dots.length > 0) {
    const slideCount = track.children.length;
    let current = 0;
    let timer: ReturnType<typeof setInterval> | undefined;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const updateDots = () => {
      dots.forEach((dot, i) => {
        dot.classList.toggle("bg-white", i === current);
        dot.classList.toggle("w-6", i === current);
        dot.classList.toggle("bg-white/40", i !== current);
      });
    };

    const goTo = (index: number) => {
      current = (index + slideCount) % slideCount;
      track.style.transform = `translateX(-${current * 100}%)`;
      updateDots();
    };

    const next = () => goTo(current + 1);
    const prev = () => goTo(current - 1);

    const start = () => {
      if (reduceMotion) return;
      stop();
      timer = setInterval(next, AUTO_ADVANCE_MS);
    };
    const stop = () => {
      if (timer) clearInterval(timer);
    };

    nextBtn?.addEventListener("click", () => {
      next();
      start();
    });
    prevBtn?.addEventListener("click", () => {
      prev();
      start();
    });
    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        goTo(Number(dot.dataset.index));
        start();
      });
    });

    root.addEventListener("mouseenter", stop);
    root.addEventListener("mouseleave", start);
    root.addEventListener("focusin", stop);
    root.addEventListener("focusout", start);

    updateDots();
    start();
  }
</script>
