---
import { Icon } from "astro-icon/components";

interface Props {
  icon: string;
  title: string;
  description: string;
  delay?: number;
}

const { icon, title, description, delay = 0 } = Astro.props;
---

<div
  class="card-hover rounded-2xl border border-slate-200 bg-white p-6 shadow-sm"
  data-reveal="up"
  style={`--reveal-delay: ${delay}ms`}
>
  <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-gradient-to-br from-amber-500 to-orange-500 text-white">
    <Icon name={icon} class="h-6 w-6" />
  </span>
  <h3 class="mt-4 text-lg font-semibold text-slate-900">{title}</h3>
  <p class="mt-2 text-sm leading-relaxed text-slate-600">{description}</p>
</div>
