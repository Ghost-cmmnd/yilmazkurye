---
interface Props {
  value: string;
  label: string;
}

const { value, label } = Astro.props;
---

<div class="text-center">
  <p class="text-2xl font-extrabold text-slate-900 sm:text-3xl">{value}</p>
  <p class="mt-1 text-xs font-medium uppercase tracking-wide text-slate-500 sm:text-sm">{label}</p>
</div>
