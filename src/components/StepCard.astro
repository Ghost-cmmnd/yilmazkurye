---
interface Props {
  step: number;
  title: string;
  description: string;
}

const { step, title, description } = Astro.props;
---

<div class="relative rounded-2xl border border-slate-200 bg-white p-6">
  <span class="flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-br from-amber-500 to-orange-500 text-lg font-bold text-white">
    {step}
  </span>
  <h3 class="mt-4 text-base font-semibold text-slate-900">{title}</h3>
  <p class="mt-2 text-sm leading-relaxed text-slate-600">{description}</p>
</div>
