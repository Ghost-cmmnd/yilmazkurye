---
import { Icon } from "astro-icon/components";

const badges = [
  { icon: "lucide:shield-check", text: "Sigortalı Taşımacılık" },
  { icon: "lucide:file-check", text: "İmzalı Teslim Garantisi" },
  { icon: "lucide:clock", text: "7/24 Kesintisiz Hizmet" },
  { icon: "lucide:lock", text: "Gizlilik Garantisi" },
];
---

<section class="border-y border-slate-100 bg-white py-6">
  <div class="mx-auto grid max-w-5xl grid-cols-2 gap-x-4 gap-y-5 px-4 sm:grid-cols-4 sm:gap-6 sm:px-6 lg:px-8">
    {badges.map((badge, i) => (
      <div class="flex items-center gap-2.5" data-reveal="up" style={`--reveal-delay: ${i * 60}ms`}>
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-amber-50 text-amber-600">
          <Icon name={badge.icon} class="h-4 w-4" />
        </span>
        <span class="text-sm font-semibold text-slate-700">{badge.text}</span>
      </div>
    ))}
  </div>
</section>
