---
import { Icon } from "astro-icon/components";
import { CONTACT } from "../data/site";

const message = encodeURIComponent("Merhaba, kurye teklifi almak istiyorum.");
const href = `https://wa.me/${CONTACT.whatsappNumber}?text=${message}`;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="WhatsApp'tan yazın"
  class="fixed bottom-5 right-5 z-40 flex items-center gap-2.5 rounded-2xl bg-[#25D366] py-3 pl-3.5 pr-4 text-white shadow-lg shadow-black/25 ring-1 ring-black/5 transition hover:-translate-y-0.5 hover:shadow-xl"
>
  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-white/15">
    <Icon name="simple-icons:whatsapp" class="h-4 w-4" />
  </span>
  <span class="whitespace-nowrap text-sm font-semibold">WhatsApp'tan Yazın</span>
</a>
