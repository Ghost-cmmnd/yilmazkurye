---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ContactFab from "../components/ContactFab.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
import { SITE_URL, SITE_NAME, DEFAULT_DESCRIPTION, CONTACT } from "../data/site";

interface Props {
  title: string;
  description?: string;
  path?: string;
}

const { title, description = DEFAULT_DESCRIPTION, path = "/" } = Astro.props;
const canonicalURL = new URL(path, SITE_URL).toString();
const pageTitle = title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`;
const ogImageURL = new URL("/og-image.png", SITE_URL).toString();

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: SITE_NAME,
  image: ogImageURL,
  url: SITE_URL,
  telephone: CONTACT.phoneTel,
  email: CONTACT.email,
  priceRange: "₺₺",
  address: {
    "@type": "PostalAddress",
    addressLocality: "Ataşehir",
    addressRegion: "İstanbul",
    addressCountry: "TR",
  },
  areaServed: {
    "@type": "City",
    name: "İstanbul",
  },
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: [
      "Monday",
      "Tuesday",
      "Wednesday",
      "Thursday",
      "Friday",
      "Saturday",
      "Sunday",
    ],
    opens: "00:00",
    closes: "23:59",
  },
};
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-site-verification" content="EroFA9q8ZzqxDHluKNHfTmQAzK9iMuX98jXeWpp1aD4" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalURL} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageURL} />

    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-sans">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <ContactFab />
    <ScrollReveal />
  </body>
</html>
