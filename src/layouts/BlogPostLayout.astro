---
import BaseLayout from "./BaseLayout.astro";
import CtaBlock from "../components/CtaBlock.astro";
import { Icon } from "astro-icon/components";

interface Props {
  title: string;
  description: string;
  date: Date;
  category: string;
  readTime: string;
  slug: string;
}

const { title, description, date, category, readTime, slug } = Astro.props;

const formattedDate = date.toLocaleDateString("tr-TR", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
---

<BaseLayout title={title} description={description} path={`/blog/${slug}`}>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <a href="/blog" class="inline-flex items-center gap-1 text-sm font-medium text-orange-600 hover:underline">
      <Icon name="lucide:arrow-left" class="h-4 w-4" />
      Tüm Yazılar
    </a>

    <div class="mt-6 flex items-center gap-3 text-sm text-slate-500">
      <span class="rounded-full bg-orange-50 px-3 py-1 font-semibold text-orange-700">{category}</span>
      <span class="flex items-center gap-1">
        <Icon name="lucide:clock" class="h-4 w-4" />
        {readTime}
      </span>
      <time datetime={date.toISOString()}>{formattedDate}</time>
    </div>

    <h1 class="mt-4 text-3xl font-extrabold leading-tight text-slate-900 sm:text-4xl">{title}</h1>

    <div class="prose prose-slate mt-10 max-w-none prose-headings:font-bold prose-h2:mt-10 prose-h2:text-2xl prose-h3:mt-6 prose-h3:text-lg">
      <slot />
    </div>

    <div class="mt-16">
      <CtaBlock />
    </div>
  </article>
</BaseLayout>
